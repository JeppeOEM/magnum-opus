# VPS connection config — copy to .env.deploy and fill in.
# Loaded automatically by Makefile and scripts/vps-deploy.sh.
# chmod 600 .env.deploy — keep private, do not commit.

# Tailscale IP of your VPS (or public IP if Tailscale not yet set up)
VPS=deploy@100.x.x.x

# Directory where the repo lives on the VPS
VPS_DIR=/home/deploy/magnum-opus

# Current active candle slot — updated automatically by vps-deploy.sh candle
CANDLE_SLOT=blue

# Optional: Telegram credentials for deploy notifications
# (Same values as in .env — copy if you want deploy notifications from your workstation)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID_DIGEST=
