# Copy to candle-service/.env and fill in values.
# chmod 600 .env — credentials must not be world-readable.
# .env is gitignored — never commit real credentials.
#
# Dev (make dev-candle): use localhost:* addresses
# Docker Compose:        use internal DNS (redis:6379, questdb:9009, questdb:9000)

# ── Service identity ──────────────────────────────────────────────────────────
# Slot must be 'blue' or 'green' — determines which docker-compose profile is active.
CANDLE_SLOT=blue
CANDLE_SERVICE_PORT=8081
SHUTDOWN_TIMEOUT_S=10

# ── Infrastructure ────────────────────────────────────────────────────────────
# Dev:    redis://localhost:6379 / localhost:9009 / localhost:9000
# Docker: redis://redis:6379    / questdb:9009   / questdb:9000
REDIS_URL=redis://localhost:6379
QUESTDB_ILP_ADDR=localhost:9009
QUESTDB_HTTP_ADDR=localhost:9000

# ── Symbols ───────────────────────────────────────────────────────────────────
# Must match config.yaml and the aggregator's subscribed symbols.
# Leave SYMBOLS_BYBIT blank if Bybit is disabled in the aggregator.
SYMBOLS_KUCOIN=BTC-USDT,ETH-USDT
SYMBOLS_BYBIT=BTCUSDT,ETHUSDT

# ── Redis consumer ────────────────────────────────────────────────────────────
CANDLE_CONSUMER_GROUP=candle-service
# Max entries kept per candles:{exchange}:{symbol} stream (rolling + partial bars).
CANDLE_STREAM_MAXLEN=10000
# Max entries kept per candles:close:{exchange}:{symbol} stream (closed bars only).
CANDLE_CLOSE_STREAM_MAXLEN=500
# How often to publish the in-progress partial bar to Redis (milliseconds).
CANDLE_PARTIAL_PUBLISH_MS=250

# ── Feature computation ───────────────────────────────────────────────────────
# Number of trades sampled for block trade rolling percentile detection.
BLOCK_TRADE_WINDOW=1000
# Minimum samples before block trade classification becomes active.
BLOCK_TRADE_MIN_SAMPLE=100
# Messages buffered during consumer cold-start (before snapshot arrives).
COLD_START_BUFFER_SIZE=10000
# How often to check QuestDB WAL suspension (seconds).
WAL_PROBE_INTERVAL_S=5
# Max rows buffered while QuestDB WAL is suspended.
WAL_BUFFER_SIZE=10000

# ── QuestDB tuning ────────────────────────────────────────────────────────────
# ILP batch flush interval (milliseconds).
QUESTDB_ILP_FLUSH_MS=500

# ── Cold storage — Backblaze B2 ───────────────────────────────────────────────
# Leave all B2_* blank to disable daily Parquet flush entirely.
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=
# Time of day to run the daily flush (HH:MM UTC).
FLUSH_TIME_UTC=03:00
# Override the flush target date for testing (YYYY-MM-DD). Leave blank in production.
FLUSH_DATE_OVERRIDE=

# ── Blue/green deployment ─────────────────────────────────────────────────────
# Max seconds to wait for shadow_lag=0 before the deploy script gives up.
DEPLOY_HEALTH_TIMEOUT_S=60
# Enable shadow XREAD mode — set by deploy-candle.sh, not manually.
CANDLE_SHADOW_MODE=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
