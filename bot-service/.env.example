# Bot Service environment variables
# Copy this file to .env — blank credentials are fine for paper trading.
# Fill in real API keys only when switching a strategy to live trading.

# --- Exchange credentials (optional — leave blank for paper trading) ---
KUCOIN_API_KEY=        # KuCoin API key (from KuCoin API management page)
KUCOIN_API_SECRET=     # KuCoin API secret
KUCOIN_API_PASSPHRASE= # KuCoin API passphrase (set when creating the API key)
BYBIT_API_KEY=         # Bybit API key
BYBIT_API_SECRET=      # Bybit API secret

# --- Infrastructure ---
REDIS_URL=redis://localhost:6379            # Redis connection URL; include :<password>@ if auth enabled
QUESTDB_ILP_ADDR=localhost:9009            # QuestDB ILP (line protocol) TCP address for order writes
QUESTDB_HTTP_ADDR=http://localhost:9000    # QuestDB HTTP REST address for DDL and reconciliation queries

# --- Bus Manager ---
BOT_CONSUMER_GROUP=bot-service  # Redis consumer group name; must stay constant across restarts
BOT_QUEUE_MAX_DEPTH=1000        # Max events buffered per strategy before oldest is dropped

# --- Subscribe / Lifecycle ---
BOT_SUBSCRIBE_TIMEOUT_S=30       # Max seconds for a strategy's subscribe() to complete
BOT_RECONCILIATION_TIMEOUT_S=120 # Max seconds for startup reconciliation against exchange REST
BOT_SHUTDOWN_TIMEOUT_S=30        # Seconds to wait for in-flight order workers before exit
BOT_FILEWATCHER_INTERVAL_S=60    # How often the file watcher rescans strategies/active/

# --- WebSocket fallback ---
BOT_WS_FALLBACK_TIMEOUT_LIVE=10  # Seconds of silence on private WS before activating REST poll (live)
BOT_WS_FALLBACK_TIMEOUT_PAPER=30 # Seconds of silence on private WS before activating REST poll (paper)

# --- Barrier timeouts (milliseconds) ---
BOT_BARRIER_TIMEOUT_MS_1S=250    # Max wait for all 1s bar closes before declaring a partial delivery
BOT_BARRIER_TIMEOUT_MS_1M=500    # Max wait for all 1m bar closes
BOT_BARRIER_TIMEOUT_MS_5M=1000   # Max wait for all 5m bar closes
BOT_BARRIER_TIMEOUT_MS_15M=2000  # Max wait for all 15m bar closes
BOT_BARRIER_TIMEOUT_MS_1H=5000   # Max wait for all 1h bar closes
BOT_BARRIER_TIMEOUT_MS_4H=10000  # Max wait for all 4h bar closes
BOT_BARRIER_TIMEOUT_MS_1D=30000  # Max wait for all 1d bar closes
BOT_BARRIER_TIMEOUT_MS_1W=60000  # Max wait for all 1w bar closes

# --- Paper trading ---
BOT_PAPER_LATENCY_MIN_MS=50    # Minimum simulated order latency for paper trading
BOT_PAPER_LATENCY_MAX_MS=250   # Maximum simulated order latency for paper trading
BOT_PAPER_SLIPPAGE_BPS=5       # Simulated slippage in basis points for paper fill price

# --- Logging ---
LOG_LEVEL=info  # Structlog output level: debug | info | warning | error | critical
