# magnum-opus aggregator — environment variable reference
# Copy to .env and fill in real values. Never commit .env.
#
# All variables listed here are required unless marked [optional].

# ── KuCoin ────────────────────────────────────────────────────────────────────
KUCOIN_API_KEY=your-kucoin-api-key
KUCOIN_API_SECRET=your-kucoin-api-secret
KUCOIN_API_PASSPHRASE=your-kucoin-passphrase

# ── Bybit ─────────────────────────────────────────────────────────────────────
BYBIT_API_KEY=your-bybit-api-key
BYBIT_API_SECRET=your-bybit-api-secret

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=                # [optional] leave empty if no auth
REDIS_STREAM_MAXLEN=50000        # max entries per ticks:{exchange}:{symbol} stream

# ── QuestDB ───────────────────────────────────────────────────────────────────
QUESTDB_ILP_ADDR=localhost:9009
QUESTDB_HTTP_ADDR=localhost:9000 # used for WAL resume REST call

# ── Symbols ───────────────────────────────────────────────────────────────────
# Comma-separated list of canonical symbols to subscribe to on each exchange.
KUCOIN_SYMBOLS=BTC-USDT,ETH-USDT
BYBIT_SYMBOLS=BTCUSDT,ETHUSDT

# ── Service ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info                   # debug | info | warn | error
HTTP_ADDR=:8080                  # operational endpoints (/health /version /metrics)
STARTUP_TIMEOUT_SEC=90           # exit non-zero if feeds not confirmed within this window
