# Copy to .env and fill in values.
# chmod 600 .env — credentials must not be world-readable.
# .env is gitignored — never commit real credentials.
#
# Dev (make dev-*):    use localhost:* addresses
# Docker Compose:      use internal DNS (redis:6379, questdb:9009, questdb:9000)

# ── KuCoin ────────────────────────────────────────────────────────────────────
# Set KUCOIN_PUBLIC=true to use the public WebSocket endpoint (no credentials needed).
# Set to false and fill in credentials to use authenticated private feeds.
KUCOIN_PUBLIC=true
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# ── Bybit ─────────────────────────────────────────────────────────────────────
# Leave blank to disable Bybit entirely (also comment out bybit section in config.yaml).
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Dev:    localhost:6379
# Docker: redis:6379
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_STREAM_MAXLEN=50000

# ── QuestDB ───────────────────────────────────────────────────────────────────
# Dev:    localhost:9009 / localhost:9000
# Docker: questdb:9009  / questdb:9000
QUESTDB_ILP_ADDR=localhost:9009
QUESTDB_HTTP_ADDR=localhost:9000

# ── Symbols ───────────────────────────────────────────────────────────────────
# Must match the exchanges/symbols section in config.yaml.
# These vars are read by the aggregator service.
KUCOIN_SYMBOLS=BTC-USDT,ETH-USDT
BYBIT_SYMBOLS=BTCUSDT,ETHUSDT

# ── Service ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
HTTP_ADDR=:8080
STARTUP_TIMEOUT_SEC=90
