# Copy this file to .env and fill in real values.
# chmod 600 .env  — credentials must not be world-readable.
# .env is gitignored — never commit real credentials.

# ── KuCoin API credentials ─────────────────────────────────────────────────────
KUCOIN_API_KEY=your-kucoin-api-key
KUCOIN_API_SECRET=your-kucoin-api-secret
KUCOIN_API_PASSPHRASE=your-kucoin-api-passphrase

# ── Bybit API credentials ──────────────────────────────────────────────────────
BYBIT_API_KEY=your-bybit-api-key
BYBIT_API_SECRET=your-bybit-api-secret

# ── Redis ─────────────────────────────────────────────────────────────────────
# Docker Compose internal DNS: redis:6379
REDIS_ADDR=redis:6379
# Optional; leave blank if Redis has no password
REDIS_PASSWORD=
# Maximum number of entries kept per stream (XADD MAXLEN). Default: 50000
REDIS_STREAM_MAXLEN=50000

# ── QuestDB ───────────────────────────────────────────────────────────────────
# ILP (InfluxDB Line Protocol) ingestion endpoint — used for raw_ticks writes
# Docker Compose internal DNS: questdb:9009
QUESTDB_ILP_ADDR=questdb:9009
# HTTP endpoint — used for WAL status checks
# Docker Compose internal DNS: questdb:9000
QUESTDB_HTTP_ADDR=questdb:9000

# ── Symbols to subscribe ──────────────────────────────────────────────────────
# Comma-separated list of exchange-native symbol strings.
KUCOIN_SYMBOLS=BTC-USDT,ETH-USDT
BYBIT_SYMBOLS=BTCUSDT,ETHUSDT

# ── Service ───────────────────────────────────────────────────────────────────
# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info
# HTTP server bind address for /health, /version, /metrics (default: :8080)
HTTP_ADDR=:8080
# Seconds to wait for all feeds to confirm subscription before aborting (default: 90)
STARTUP_TIMEOUT_SEC=90
